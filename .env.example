# MongoDB Atlas connection string
MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/risk-radar?retryWrites=true&w=majority

# OpenRouter API key (https://openrouter.ai)
OPENROUTER_API_KEY=your_openrouter_api_key_here

# OpenRouter model ID — must support structured JSON output
OPENROUTER_MODEL=google/gemini-2.5-flash

# Auth.js / NextAuth secret (generate using: openssl rand -base64 32)
AUTH_SECRET=your_auth_secret_here
NEXTAUTH_SECRET=your_auth_secret_here

# Google OAuth credentials (https://console.cloud.google.com/apis/credentials)
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# Microsoft Entra ID OAuth credentials (https://portal.azure.com)
AUTH_MICROSOFT_ENTRA_ID_ID=your_microsoft_client_id_here
AUTH_MICROSOFT_ENTRA_ID_SECRET=your_microsoft_client_secret_here
AUTH_MICROSOFT_ENTRA_ID_ISSUER=https://login.microsoftonline.com/your-tenant-id/v2.0

# GitHub OAuth credentials (https://github.com/settings/developers)
AUTH_GITHUB_ID=your_github_client_id_here
AUTH_GITHUB_SECRET=your_github_client_secret_here

# Public app URL (e.g., https://your-render-app.onrender.com or http://localhost:3000)
NEXT_PUBLIC_APP_URL=https://your-render-app.onrender.com
NEXTAUTH_URL=https://your-render-app.onrender.com

# OpenAI API key — used server-side for Text-to-Speech (tts-1) if enabled
OPENAI_API_KEY=

# WhatsApp Cloud API — for automated threat alerts
# Setup: https://developers.facebook.com/docs/whatsapp/cloud-api/get-started
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_VERIFY_TOKEN=your_random_webhook_verify_token
WHATSAPP_ALERT_RECIPIENT=91XXXXXXXXXX
