# MongoDB Atlas connection string
MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/shieldsense?retryWrites=true&w=majority

# OpenRouter API key (https://openrouter.ai)
OPENROUTER_API_KEY=your_openrouter_api_key_here

# OpenRouter model ID — must support structured JSON output
OPENROUTER_MODEL=google/gemini-2.5-flash

# Optional: Public app URL (used for OG tags, etc.)
NEXT_PUBLIC_APP_URL=https://your-render-app.onrender.com

# OpenAI API key — used ONLY server-side for Text-to-Speech (tts-1)
OPENAI_API_KEY=

# WhatsApp Cloud API — for automated threat alerts
# Setup: https://developers.facebook.com/docs/whatsapp/cloud-api/get-started
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_VERIFY_TOKEN=your_random_webhook_verify_token
WHATSAPP_ALERT_RECIPIENT=91XXXXXXXXXX
